{
  "name": "moex-bot",
  "version": "0.1.0",
  "description": "Торговый бот для Мосбиржи (Tinkoff Invest API)",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node dist/bot.js",
    "start": "tsx src/index.ts",
    "calibrate": "tsx scripts/calibrateBollinger.ts"
  },
  "keywords": [
    "moex",
    "tinkoff",
    "trading",
    "bot"
  ],
  "license": "ISC",
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@tinkoff/invest-js": "1.27.1-RC4",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.5",
    "grammy": "^1.38.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
